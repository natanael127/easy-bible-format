{
    "$schema": "http://json-schema.org/draft-07/schema",
    "definitions": {
        "usfmId": {
            "type": "string",
            "enum": [
                "GEN", "EXO", "LEV", "NUM", "DEU", "JOS", "JDG", "RUT", "1SA", "2SA",
                "1KI", "2KI", "1CH", "2CH", "EZR", "NEH", "EST", "JOB", "PSA", "PRO",
                "ECC", "SNG", "ISA", "JER", "LAM", "EZK", "DAN", "HOS", "JOL", "AMO",
                "OBA", "JON", "MIC", "NAM", "HAB", "ZEP", "HAG", "ZEC", "MAL", "MAT",
                "MRK", "LUK", "JHN", "ACT", "ROM", "1CO", "2CO", "GAL", "EPH", "PHP",
                "COL", "1TH", "2TH", "1TI", "2TI", "TIT", "PHM", "HEB", "JAS", "1PE",
                "2PE", "1JN", "2JN", "3JN", "JUD", "REV", "TOB", "JDT", "ESG", "WIS",
                "SIR", "BAR", "LJE", "S3Y", "SUS", "BEL", "1MA", "2MA", "3MA", "4MA",
                "1ES", "2ES", "MAN", "PS2", "ODA", "PSS", "EZA", "5EZ", "6EZ", "DAG",
                "PS3", "2BA", "LBA", "JUB", "ENO", "1MQ", "2MQ", "3MQ", "REP", "4BA",
                "LAO", "FRT", "BAK", "OTH", "INT", "CNC", "GLO", "TDX", "NDX", "XXA",
                "XXB", "XXC", "XXD", "XXE", "XXF", "XXG"
            ]
        },
        "trimmedText": {
            "type": "string",
            "pattern": "^\\S([\\s\\S]*\\S)?$",
            "description": "Non-empty text without leading or trailing whitespace"
        },
        "reference": {
            "type": "object",
            "properties": {
                "usfm_id": {
                    "$ref": "#/definitions/usfmId"
                },
                "chapter": {
                    "type": "integer",
                    "minimum": 1
                },
                "verse": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "usfm_id",
                "chapter",
                "verse"
            ],
            "additionalProperties": false
        },
        "verse": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "pattern": "^(\\S([\\s\\S]*\\S)?)?$",
                    "description": "Verse text without leading or trailing whitespace; empty for verses kept only for numbering"
                },
                "title": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Section title before the verse"
                },
                "comment": {
                    "$ref": "#/definitions/trimmedText"
                },
                "references": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/reference"
                    }
                }
            },
            "required": [
                "text"
            ],
            "additionalProperties": false
        },
        "chapter": {
            "type": "object",
            "properties": {
                "title": {
                    "$ref": "#/definitions/trimmedText"
                },
                "comment": {
                    "$ref": "#/definitions/trimmedText"
                },
                "verses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/verse"
                    }
                }
            },
            "required": [
                "verses"
            ],
            "additionalProperties": false
        },
        "book": {
            "type": "object",
            "properties": {
                "names": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/definitions/trimmedText"
                    }
                },
                "abbreviation": {
                    "type": "string",
                    "pattern": "^\\S+$",
                    "description": "Short name used in references, e.g. \"Mt\"; no whitespace"
                },
                "usfm_id": {
                    "$ref": "#/definitions/usfmId"
                },
                "chapters": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/chapter"
                    }
                }
            },
            "required": [
                "names",
                "abbreviation",
                "usfm_id",
                "chapters"
            ],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "bible": {
            "type": "object",
            "properties": {
                "name": {
                    "$ref": "#/definitions/trimmedText"
                },
                "language": {
                    "type": "string",
                    "pattern": "^[a-z]{3}$",
                    "description": "ISO 639-3 language code in lowercase, e.g. \"por\""
                },
                "books": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/book"
                    }
                }
            },
            "required": [
                "name",
                "language",
                "books"
            ],
            "additionalProperties": false
        },
        "metadata": {
            "type": "object",
            "properties": {
                "file_hash": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "bible"
    ],
    "additionalProperties": false
}
